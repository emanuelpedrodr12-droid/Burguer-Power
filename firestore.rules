rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'xboxbrstream@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'address', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'customerName', 'customerPhone', 'deliveryType', 'paymentMethod', 'items', 'total', 'status'])
        && data.keys().hasOnly(['id', 'userId', 'customerName', 'customerPhone', 'deliveryType', 'address', 'paymentMethod', 'changeFor', 'items', 'subtotal', 'deliveryFee', 'total', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.deliveryType in ['delivery', 'retirada']
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.paymentMethod in ['pix', 'cartao', 'dinheiro']
        && (!('changeFor' in data) || (data.changeFor is string && data.changeFor.size() <= 50))
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0))
        && (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0))
        && data.status in ['recebido', 'em_preparo', 'saiu_entrega', 'concluido', 'cancelado']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'price', 'category', 'imageUrl'])
        && data.title is string && data.title.size() <= 120
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 60
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('available' in data) || (data.available is bool))
        && (!('rating' in data) || (data.rating is number))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('isPopular' in data) || (data.isPopular is bool));
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false; // Strict PII protection
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() || (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          (existing().status == 'recebido' || existing().status == 'em_preparo') &&
          incoming().status == 'cancelado' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && isValidId(orderId) && existing().userId == request.auth.uid && existing().status == 'cancelado');
    }

    // Products collection (Digital Menu)
    match /products/{productId} {
      allow read: if true; // Public access to digital menu items
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }
  }
}
